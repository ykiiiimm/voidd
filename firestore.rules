rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site_content/{docId} {
      allow read: if true;
      allow write: if docId in ['articles', 'projects', 'services', 'team', 'settings']
                   && request.resource.data.size() < 1000000;
    }
  }
}
